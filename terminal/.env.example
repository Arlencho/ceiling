# Copy to terminal/.env if you want file-based config. The watcher and the
# terminal both read this file, watcher/.env, and keys/devnet-addresses.env
# (public addresses only). Keys may be VETO_RPC= or RPC=. Never commit a
# real .env.

# Cluster recorded in docs/DEVNET.md. Override to any Solana JSON-RPC.
# VETO_RPC is required and has no default. One URL, or several separated by
# commas, tried in order. This line is commented out deliberately: terminal/.env
# is a file the loader searches, so an example that carries a real endpoint hands
# back the default the loader exists to refuse.
# VETO_RPC=

# Port for the screen and the agent quote endpoint.
VETO_TERMINAL_PORT=8788

# Volume quoted per window, in millikWh (50000 = 50 kWh).
VETO_KWH_MILLI=50000
