{
  "name": "@veto-hq/veto",
  "version": "0.1.0",
  "private": true,
  "comment": "Depends on @veto-hq/agent-sdk by file:../sdk until that package is on npm.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "veto": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "@veto-hq/agent-sdk": "file:../sdk",
    "qrcode-terminal": "0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3"
  }
}
