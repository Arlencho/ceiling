# Copy to watcher/.env if you want file-based config. The process also reads
# the environment and keys/devnet-addresses.env (public addresses only).
# Keypair paths stay under gitignored keys/. Never commit a real .env.
#
# Identity lines are commented placeholders. They do not resolve. Uncomment
# and supply a value; copying this file as-is leaves those variables unset.

# VETO_RPC=<json-rpc url>
# VETO_PROGRAM_ID=<base58>
# VETO_MINT=<base58>
# VETO_OWNER=<base58>
# VETO_OWNER_TOKEN=<base58>
# VETO_MERCHANT=<base58>
# VETO_MERCHANT_TOKEN=<base58>
# VETO_AGENT=<base58>

VETO_KEYS_DIR=../keys
VETO_JOURNAL=./data/decisions.jsonl
VETO_MANDATE_ID=1
VETO_KWH_MILLI=50000
VETO_MINT_DECIMALS=6
