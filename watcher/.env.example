# Copy to watcher/.env if you want file-based config. The process also reads
# the environment and keys/devnet-addresses.env (public addresses only).
# Keypair paths stay under gitignored keys/. Never commit a real .env.

# One JSON-RPC URL, or a comma-separated list. First is tried first.
# Put a dedicated endpoint first and keep the public cluster URL as fallback.
# A 429 walks the rest and is logged as a rate limit, not a failure.
VETO_RPC=http://127.0.0.1:8999
VETO_KEYS_DIR=../keys
VETO_JOURNAL=./data/decisions.jsonl
VETO_MANDATE_ID=1
VETO_KWH_MILLI=50000
VETO_MINT_DECIMALS=6
