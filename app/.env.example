# Copy to app/.env (gitignored). Values come from docs/DEVNET.md and keys/devnet-addresses.env.
# Do not commit real secrets. These are public cluster addresses and the RPC url.

EXPO_PUBLIC_VETO_RPC=
EXPO_PUBLIC_VETO_PROGRAM_ID=
# Devnet default token is Circle USDC (6 decimals). Nobody can mint it. Get it from https://faucet.circle.com.
EXPO_PUBLIC_VETO_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
EXPO_PUBLIC_VETO_EXPLORER_CLUSTER=devnet
EXPO_PUBLIC_VETO_MINT_DECIMALS=6
