# Copy to indexer/.env if you want file-based config. The process also reads
# the environment and keys/devnet-addresses.env (public addresses only).
# Keypairs for the seed script stay under gitignored keys/. Never commit a real .env.

# Cluster recorded in docs/DEVNET.md. One JSON-RPC URL, or a comma-separated
# list. First is tried first. Put a dedicated endpoint first and keep the
# public cluster URL as fallback. A 429 walks the rest and is logged as a
# rate limit, not a failure.
VETO_RPC=http://127.0.0.1:8999
VETO_PROGRAM_ID=3zNp5EuQ61pR9stq4rzYsRQnjg4AYAgW8nxRje6koQmV

# Optional. When set, history is filtered to this mandate PDA.
# VETO_MANDATE=

# Signature page size (1..1000). Use a small value to prove pagination.
# VETO_PAGE_SIZE=1000

# Seed only. Omit to pick a fresh mandate id.
# VETO_MANDATE_ID=
# VETO_KEYS_DIR=../keys
